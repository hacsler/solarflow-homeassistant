== EFFECTIVE VALUES (calculated) ==
{{ '%-30s' | format('Active cutoff') }}{{ states('input_number.zendure_conf_soc_off_' ~ season) | float(20) | round(0) | int }} %
{{ '%-30s' | format('Active bypass limit') }}{{ states('input_number.zendure_conf_soc_bypass' ~ ('_winter' if season == 'winter' else '')) | float(20) | round(0) | int }} %
{{ '%-30s' | format('Active grid buffer') }}{{ states('input_number.zendure_conf_grid_bias_' ~ season) | float(0) | round(0) | int }} W
{{ '%-30s' | format('D2 failsafe effective') }}{{ (states('input_number.zendure_conf_failsafe_watt') | float(130) * capf) | round(0) | int }} W
{{ '%-30s' | format('D2 emergency power effective') }}{{ (states('input_number.zendure_conf_emergency_watt') | float(500) * capf) | round(0) | int }} W
{{ '%-30s' | format('D2 min. output full effective') }}{{ (states('input_number.zendure_conf_saturation_watt_' ~ season) | float(250) * pvf) | round(0) | int }} W
{{ '%-30s' | format('D1 forecast trigger (raw)') }}{{ (thr / ff) | round(2) }} kWh
{{ '%-30s' | format('D2 forecast trigger (raw)') }}{{ (thr * pvf / ff) | round(2) }} kWh
{% set rel = states('input_number.zendure_2_conf_discharge_release_soc') | float(0) -%}
{{ '%-30s' | format('D2 re-lock below') }}{{ 'off (release 0)' if rel <= 0 else ((rel - states('input_number.zendure_2_conf_discharge_hysteresis') | float(5)) | round(0) | int ~ ' %') }}
