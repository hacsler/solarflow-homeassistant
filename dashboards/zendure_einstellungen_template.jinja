{{ z('input_number.zendure_2_conf_capacity_factor', 'Kapazitätsfaktor (G1 = 1)') -}}
{{ z('input_number.zendure_2_conf_pv_factor', 'PV-Faktor (G1 = 1)') -}}
{{ z('input_number.zendure_2_conf_discharge_release_soc', 'Freigabe ab (0=aus)') -}}
{{ z('input_number.zendure_2_conf_discharge_hysteresis', 'Sperr-Hysterese Charge-First') -}}
{{ z('input_number.zendure_2_conf_assist_deficit_w', 'Assist ab Fehlbetrag (0=aus)') -}}
{{ z('input_number.zendure_2_conf_assist_min_soc', 'Assist Mindest-Ladestand') -}}
