{# ===== Zendure: alle Einstellungen mit aktuellem Wert =====
   In Home Assistant: Entwicklerwerkzeuge -> Template, kompletten Inhalt einfügen.
   Nur Anzeige, ändert nichts. Fehlt ein Helper, steht "<-- fehlt/unavailable". -#}
{% macro z(e, t) -%}
{% set v = states(e) -%}
{% set u = state_attr(e, 'unit_of_measurement') or '' -%}
{{ '%-30s' | format(t) }}{{ ('%g' | format(v | float)) if v | is_number else ('(leer)' if v == '' else v) }}{{ ' ' ~ u if (u and v | is_number) else '' }}{{ '   <-- fehlt/unavailable' if v in ['unknown', 'unavailable'] else '' }}
{% endmacro -%}
{% set season = 'summer' if states('sensor.zendure_active_season') == 'summer' else 'winter' -%}
{% set ff = states('input_number.zendure_conf_forecast_factor') | float(100) / 100 -%}
{% set capf = states('input_number.zendure_2_conf_capacity_factor') | float(0.5) -%}
{% set pvf = states('input_number.zendure_2_conf_pv_factor') | float(0.25) -%}
{% set thr = states('input_number.zendure_conf_forecast_thresh') | float(2.5) -%}
== ALLGEMEIN ==
{{ z('sensor.zendure_active_season', 'Aktive Saison') -}}
{{ z('input_datetime.zendure_conf_winter_start', 'Winterbeginn') -}}
{{ z('input_datetime.zendure_conf_summer_start', 'Sommerbeginn') -}}
{{ z('input_boolean.zendure_auto_mode', 'Auto-Modus Gerät 1') -}}
{{ z('input_boolean.zendure_coordinator_enabled', 'Koordinator aktiv') -}}
{{ z('input_boolean.zendure_dry_run', 'Dry-Run (nur testen)') -}}
{{ z('input_select.zendure_allocation_strategy', 'Verteilstrategie') -}}
{{ z('input_boolean.zendure_enabled', 'Gerät 1 aktiviert') -}}
{{ z('input_boolean.zendure_2_enabled', 'Gerät 2 aktiviert') -}}
{{ z('input_text.zendure_device_ip', 'IP Gerät 1') -}}
{{ z('input_text.zendure_device_2_ip', 'IP Gerät 2') }}
== REGELUNG (beide Geräte) ==
{{ z('input_number.zendure_conf_max_output', 'Max. Abgabe pro Gerät') -}}
{{ z('input_number.zendure_conf_hysteresis', 'Regel-Hysterese') -}}
{{ z('input_number.zendure_conf_grid_bias_winter', 'Netz-Puffer Winter') -}}
{{ z('input_number.zendure_conf_grid_bias_summer', 'Netz-Puffer Sommer') -}}
{{ z('input_number.zendure_conf_failsafe_watt', 'Failsafe-Grundlast (Shelly)') -}}
{{ z('input_number.zendure_conf_saturation_watt_winter', 'Min. Abgabe voll (Winter)') -}}
{{ z('input_number.zendure_conf_saturation_watt_summer', 'Min. Abgabe voll (Sommer)') }}
== AKKU-GRENZEN ==
{{ z('input_number.zendure_conf_soc_off_winter', 'Abschaltgrenze Winter') -}}
{{ z('input_number.zendure_conf_soc_off_summer', 'Abschaltgrenze Sommer') -}}
{{ z('input_number.zendure_conf_soc_bypass_winter', 'Bypass nur PV (Winter)') -}}
{{ z('input_number.zendure_conf_soc_bypass', 'Bypass nur PV (Sommer)') -}}
{{ z('input_number.zendure_conf_soc_emerg_start', 'Notladung Start unter') -}}
{{ z('input_number.zendure_conf_soc_emerg_stop', 'Notladung Stopp über') -}}
{{ z('input_number.zendure_conf_emergency_watt', 'AC-Ladeleistung Notladung') -}}
{{ z('input_number.zendure_conf_calib_days', 'Kalibrierung nach Tagen') }}
== PROGNOSE ==
{{ z('input_number.zendure_conf_forecast_factor', 'Prognose-Faktor') -}}
{{ z('input_number.zendure_conf_forecast_thresh', 'Prognoseschwelle Notladung') -}}
{{ z('input_text.zmon_fc_suffix_1', 'Prognose-Suffix Gerät 1') -}}
{{ z('input_text.zmon_fc_suffix_2', 'Prognose-Suffix Gerät 2') }}
== GERÄT 1 STATUS ==
{{ z('input_boolean.zendure_emergency_charge', 'Notladung G1 aktiv') -}}
{{ z('input_boolean.zendure_calibration_mode', 'Kalibrierung G1 läuft') -}}
