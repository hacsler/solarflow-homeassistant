{{ z('sensor.zendure_assist_deficit', 'Fehlbetrag andere Geräte') }}
== WIRKSAME WERTE (berechnet) ==
{{ '%-30s' | format('Aktive Abschaltgrenze') }}{{ states('input_number.zendure_conf_soc_off_' ~ season) | float(20) | round(0) | int }} %
{{ '%-30s' | format('Aktive Bypass-Grenze') }}{{ states('input_number.zendure_conf_soc_bypass' ~ ('_winter' if season == 'winter' else '')) | float(20) | round(0) | int }} %
{{ '%-30s' | format('Aktiver Netz-Puffer') }}{{ states('input_number.zendure_conf_grid_bias_' ~ season) | float(0) | round(0) | int }} W
{{ '%-30s' | format('G2 Failsafe wirksam') }}{{ (states('input_number.zendure_conf_failsafe_watt') | float(130) * capf) | round(0) | int }} W
{{ '%-30s' | format('G2 Notladeleistung wirksam') }}{{ (states('input_number.zendure_conf_emergency_watt') | float(500) * capf) | round(0) | int }} W
{{ '%-30s' | format('G2 Min. Abgabe voll wirksam') }}{{ (states('input_number.zendure_conf_saturation_watt_' ~ season) | float(250) * pvf) | round(0) | int }} W
{{ '%-30s' | format('G1 Prognose-Auslöser (roh)') }}{{ (thr / ff) | round(2) }} kWh
{{ '%-30s' | format('G2 Prognose-Auslöser (roh)') }}{{ (thr * pvf / ff) | round(2) }} kWh
{% set rel = states('input_number.zendure_2_conf_discharge_release_soc') | float(0) -%}
{{ '%-30s' | format('G2 Wiedersperre unter') }}{{ 'aus (Freigabe 0)' if rel <= 0 else ((rel - states('input_number.zendure_2_conf_discharge_hysteresis') | float(5)) | round(0) | int ~ ' %') }}
